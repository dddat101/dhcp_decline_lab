# Copy to config.env and edit.

# ----------------------------
# PC1 - DUT WAN client test
# ----------------------------
WAN_IF=enx000000000001
DUT_WAN_MAC=02:11:22:33:44:55

WAN_BR=br-test-wan
NS_SRV=ns-srv
NS_ATK=ns-atk

WAN_SERVER_IP=10.10.0.1
WAN_PREFIX=24
WAN_CONFLICT_IP=10.10.0.100
WAN_POOL_START=10.10.0.100
WAN_POOL_END=10.10.0.110
WAN_LEASE=10m

# ----------------------------
# PC2 - DUT LAN server test
# ----------------------------
LAN_IF=enp3s0
NS_LAN=ns-lan1
DUT_LAN_IP=192.168.1.1

# ----------------------------
# General
# ----------------------------
RESULTS_DIR=./results

# Refuse to touch an interface used by the current default route.
# Set FORCE=1 only if you have independent management access.
FORCE=0
